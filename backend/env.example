# Default: local Ollama (no API key required)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional shared generation settings
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Evaluate every chatbot response with a second LLM call.
LLM_JUDGE_ENABLED=true

# Optional: generate an independent OpenAI reference answer for every completed
# chat and save it in the CSV's ChatGPT Result and Improved Answer columns.
# Without this key those two cells remain blank; the chatbot still works.
OPENAI_API_KEY=
OPENAI_REFERENCE_MODEL=gpt-4o-mini
OPENAI_REFERENCE_BASE_URL=https://api.openai.com/v1
OPENAI_REFERENCE_TIMEOUT=120
OPENAI_REFERENCE_MAX_TOKENS=1600

# Optional Flask debugger/reloader. Keep false for normal `python3 app.py` starts.
FLASK_DEBUG=false

# Semantic document retrieval. Set true once while online to download/cache the model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ALLOW_DOWNLOAD=false
# Keep local indexing memory use bounded for large document libraries.
CHROMA_INGEST_BATCH_SIZE=64

# To use any OpenAI-compatible provider instead, uncomment and set these:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-api-key
